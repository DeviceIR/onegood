# ONE GOOD — environment template
# Copy to .env and fill values. Do not commit real secrets.

NODE_ENV=development
DATABASE_URL=postgresql://hafez:hafez@localhost:5432/hafez?schema=public
AUTH_SECRET=dev-secret-change-me-to-32chars-min
AUTH_URL=http://localhost:3000

# mock | zarinpal  (keep mock until Phase 11)
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Storage: local (dev) | s3 (production)
STORAGE_DRIVER=local
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BUCKET=hafez-public
S3_PRIVATE_BUCKET=hafez-private
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=

CRON_SECRET=dev-cron-secret

# Optional: nightly backup upload target (deploy/nightly-backup.sh)
# BACKUP_S3_URI=s3://hafez-private/backups/
